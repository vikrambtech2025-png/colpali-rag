# ===== ColPali RAG configuration =====
# Copy to .env and edit. Everything here is read by pydantic-settings.

# --- Local model / hardware ---
# COLPAli_MODEL=vidore/colqwen2-v1.0-hf  # visual retriever (fits 6GB VRAM fp16)
# TEXT_EMBED_MODEL=BAAI/bge-large-en-v1.5  # dense text embeddings (1024d)
# TEXT_SPARSE_MODEL=Qdrant/bm25             # sparse text leg (BM25, CPU)
# device=auto                            # auto | cuda | cpu

# --- OmniRoute gateway (final answer generation, free-tier LLMs) ---
# Any OpenAI-compatible endpoint works (OmniRoute, Ollama /v1, LM Studio /v1).
# OMNIRoute_MODEL is the model id served by that endpoint - verify with GET <base>/models.
# Verified working on this gateway (cfp pool): cfp/zai-org/glm-5.2, cfp/deepseek-ai/deepseek-v4-pro-0813
OMNIRoute_BASE_URL=http://localhost:8080/v1
OMNIRoute_API_KEY=local
OMNIRoute_MODEL=cfp/zai-org/glm-5.2
GENERATION_MODE=text                     # text | extractive | vision (extractive = local no-LLM answers)
GENERATION_TOP_PAGES=3
LLM_TIMEOUT=90

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
# Set a shared secret to require auth on every /v1 endpoint except health/ready.
# The web UI prompts for it once and remembers it (X-API-Key header).
# API_KEY=                                # << strongly recommended before exposing this server

# --- Indexing ---
OCR_ENABLED=false                        # set true to OCR pages with no text layer

# --- Vector store: hosted Qdrant (optional, recommended for a real deployment) ---
# Leave both commented out to run Qdrant in local embedded mode
# (single writer process = the API server). Set them to use your hosted
# Qdrant cluster: server-side late-interaction MaxSim, concurrent reads/writes,
# no local data files. Get the URL + API key from your Qdrant Cloud dashboard.
# QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
# QDRANT_API_KEY=                       # never commit this value